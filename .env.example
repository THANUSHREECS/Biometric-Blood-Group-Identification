# Environment Configuration for Biometric Blood Group Identification System

# Flask Settings
FLASK_APP=app.py
FLASK_ENV=production
PORT=5000

# Mantra MFS100 Scanner Mode
# Set to 'true' to use authentic sample fingerprints in data/sample/
# Set to 'false' to connect to physical USB MFS100 device via native SDK
MFS100_MOCK=true

# Native MFS100 SDK Path (Windows)
MFS100_SDK_PATH="C:\\Program Files\\Mantra\\MFS100\\Driver\\MFS100Test\\MFS100Dll.dll"

# Confidence Threshold (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.60
